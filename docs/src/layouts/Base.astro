---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/newsreader';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, u, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  page?: PageKey;
}
const { lang, title, description, page } = Astro.props;

const origin = new URL(Astro.site ?? 'https://example.com').origin;
const abs = (p: string) => `${origin}${u(p)}`;
const enUrl = abs(routes[page ?? 'home'].en);
const deUrl = abs(routes[page ?? 'home'].de);
const canonical = page || lang === 'de' ? abs(routes[page ?? 'home'][lang]) : enUrl;
const logoCss = `:root{--logo-src:url('${u('media/logo.png')}')}:root[data-theme='dark']{--logo-src:url('${u('media/logo-light.png')}')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('media/apple-touch-icon.png')} />
    <meta name="theme-color" content="#15325C" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080B11" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CryptoBAP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('media/og-image.png')} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <style is:inline set:html={logoCss}></style>
    <!-- Apply the saved/preferred theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('cryptobap-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
    </a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Theme toggle
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('cryptobap-theme', next);
          } catch {}
        });
      });

      // Sticky header shadow + mobile menu
      const header = document.querySelector('[data-header]');
      const burger = document.querySelector('[data-burger]');
      const mnav = document.querySelector<HTMLElement>('[data-mobile-nav]');
      const onScroll = () => {
        if (!header) return;
        if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
        else header.removeAttribute('data-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      if (burger && mnav) {
        burger.addEventListener('click', () => {
          const open = burger.getAttribute('aria-expanded') === 'true';
          burger.setAttribute('aria-expanded', String(!open));
          mnav.hidden = open;
        });
        window.matchMedia('(min-width: 1001px)').addEventListener('change', (e) => {
          if (e.matches) {
            burger.setAttribute('aria-expanded', 'false');
            mnav.hidden = true;
          }
        });
      }

      // Scroll-reveal
      const items = document.querySelectorAll('[data-reveal]');
      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: '0px 0px 6% 0px', threshold: 0 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

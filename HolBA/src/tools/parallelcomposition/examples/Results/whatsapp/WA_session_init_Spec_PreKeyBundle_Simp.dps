let register(A) =
new skA;
let pkA = pk(skA,A) in
let prA = pr(skA,A) in
let sigA = sign(prA,skA,A) in
out(WAS,(A,pkA,prA,sigA,s1)).

// Identify micro-architectural leakage by conditional noninterference


let FetchServer_NewSession_Cons =
in(WAS,ApreBundle);
let (A,pkA,prA,sigA,otpkA)=ApreBundle in
NewSession_Cons(A,pkA,prA,sigA,otpkA).


let FetchServer_NewSession_Spec =
in(WAS,ApreBundle);
let (A,pkA,prA,sigA,otpkA)=ApreBundle in
NewSession_Spec(A,pkA,prA,sigA,otpkA).


let system1 =
(
register(U) |
FetchServer_NewSession_Cons
).

let system2 =
(
register(U) |
FetchServer_NewSession_Spec
).

query trace_equiv(system1,system2).


// Check if unlinkability holds while micro-architectural leakage exists

let fstFetchServer =
in(WAS,ApreBundle);
let (A,pkA,prA,sigA,otpkA)=ApreBundle in
NewSession_Spec(A,pkA,prA,sigA,otpkA).

let sndFetchServer =
in(WAS,ApreBundle);
let (A,pkA,prA,sigA,otpkA)=ApreBundle in
NewSession_Spec(A,pkA,prA,sigA,s0).

let inactive =
in(WAS,ApreBundle);
let (A,pkA,prA,sigA,otpkA)=ApreBundle in
NewSession_Spec(A,pkA,s0,sigA,otpkA).

let system3 =
(
register(U) |
fstFetchServer
).

let system4 =
(
register(U) |
sndFetchServer
).


let system5 =
(
register(U) |
fstFetchServer
).

let system6 =
(
register(U) |
inactive
).

query trace_equiv(system3,system4).

query trace_equiv(system5,system6).

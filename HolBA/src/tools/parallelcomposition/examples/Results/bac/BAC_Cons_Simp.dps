// Description of the reader role

let reader(k_e,k_m) =
  out(att,challenge);
  in(att,xn_t);
  new n_r;
  new k_r;
  let xm = enc((n_r,xn_t,k_r),k_e) in
  out(att,(xm,mac(xm,k_m)));
  in(att,y).

// Extracted passport role

let passport(ke_1, km_1)=
    let SP_EL0_5_1=Minus(SP_EL0_sy, s2608) in
    let MEM_22_1=Store(Store(MEM_sy, R29_sy, SP_EL0_5_1), R30_sy,
                       Plus(SP_EL0_5_1, s8)) in
    let MEM_39_1=Store(MEM_22_1, R0_sy, Plus(SP_EL0_5_1, s24)) in
    let MEM_52_1=Store(MEM_39_1, R1_sy, Plus(SP_EL0_5_1, s16)) in
    let R0_55_1=s0 in
    let R0_64_1=Load(MEM_52_1, s0) in
    let R1_73_1=Load(MEM_52_1, R0_64_1) in
    let MEM_86_1=Store(MEM_52_1, R1_73_1, Plus(SP_EL0_5_1, s2600)) in
    let R1_89_1=s0 in
    in(att,a_92_1);
    let MEM_106_1=Store(MEM_86_1, LowCast(R0_95, s8),
                        Plus(SP_EL0_5_1, s40)) in
    let R2_111_1=Minus(SP_EL0_sy, s2568) in
    let R0_114_1=s0 in
    let R1_117_1=s0 in
    let check_121_1=compare(a_92_1, challenge) in
    let ProcState_Z_129_1=Equal(LowCast(check_121_1, s32), s0) in
    out(att,Equal(LowCast(check_121_1, s32), s0));
    if LowCast(check_121_1, s32)=s0 then 
        (out(att,s320);
         new nonce_142_1;
         let RAND_NUM_141_1=nonce_142_1 in
         let MEM_156_1=Store(MEM_122, LowCast(R0_145, s8),
                             Plus(SP_EL0_5_1, s296)) in
         let R0_161_1=Minus(SP_EL0_sy, s2312) in
         out(att,RAND_NUM_141_1);
         in(att,a_166_1);
         let MEM_180_1=Store(MEM_156_1, LowCast(R0_169, s8),
                             Plus(SP_EL0_5_1, s552)) in
         let pars12_182_1=pars12(a_166_1) in
         let MEM_196_1=Store(MEM_180_1, LowCast(R0_185, s8),
                             Plus(SP_EL0_5_1, s808)) in
         let R0_201_1=Minus(SP_EL0_sy, s2056) in
         let R1_212_1=Load(MEM_196_1, Plus(SP_EL0_5_1, s16)) in
         let mac_214_1=mac(pars12_182_1, km_1) in
         let MEM_228_1=Store(MEM_196_1, LowCast(R0_217, s8),
                             Plus(SP_EL0_5_1, s1064)) in
         let R1_233_1=Minus(SP_EL0_sy, s1800) in
         let R0_238_1=Minus(SP_EL0_sy, s1544) in
         let cmpmac_240_1=compare_mac(pars22(a_166_1), mac_214_1) in
         let ProcState_Z_248_1=Equal(LowCast(cmpmac_240_1, s32), s0) in
         out(att,Equal(LowCast(cmpmac_240_1, s32), s0));
         if LowCast(cmpmac_240_1, s32)=s0 then 
             (out(att,s404);
              let R3_263_1=Minus(SP_EL0_sy, s776) in
              let R2_268_1=Minus(SP_EL0_sy, s1032) in
              let R1_273_1=Minus(SP_EL0_sy, s1288) in
              let R0_278_1=Minus(SP_EL0_sy, s2056) in
              let R1_295_1=Load(MEM_241, Plus(SP_EL0_5_1, s24)) in
              let Dec_297_1=dec(pars12_182_1, ke_1) in
              let Pars13_300_1=pars13(Dec_297_1) in
              let Pars23_301_1=pars23(Dec_297_1) in
              let ProcState_Z_307_1=Equal(LowCast(Dec_297_1, s32), s0) in
              out(att,Equal(LowCast(Dec_297_1, s32), s0));
              if LowCast(Dec_297_1, s32)=s0 then 
                  (out(att,s532);
                   let R0_320_1=s0 in
                   0
                   else out(att,s448);
                        let R1_325_1=Minus(SP_EL0_sy, s2312) in
                        let R0_330_1=Minus(SP_EL0_sy, s1032) in
                        let cmpnonce_332_1=compare_nonces(Pars23_301_1, RAND_NUM_141_1) in
                        let ProcState_Z_340_1=Equal(LowCast(cmpnonce_332_1, s32), s0) in
                        out(att,Equal(LowCast(cmpnonce_332_1, s32), s0));
                        if LowCast(cmpnonce_332_1, s32)=s0 then 
                            (out(att,s468);
                             new nonce_353_1;
                             let RAND_NUM_352_1=nonce_353_1 in
                             let MEM_367_1=Store(MEM_333, LowCast(R0_356, s8),
                                                 Plus(SP_EL0_5_1, s2088)) in
                             let R3_372_1=Minus(SP_EL0_sy, s264) in
                             let R2_377_1=Minus(SP_EL0_sy, s520) in
                             let R1_382_1=Minus(SP_EL0_sy, s1288) in
                             let R0_387_1=Minus(SP_EL0_sy, s2312) in
                             let R3_400_1=Load(MEM_367_1, Plus(SP_EL0_5_1, s24)) in
                             let Conc_402_1=conc3(Pars23_301_1, RAND_NUM_352_1, Pars13_300_1) in
                             let Enc_405_1=enc(Conc_402_1, ke_1) in
                             out(att,Enc_405_1);
                             let R0_411_1=Minus(SP_EL0_sy, s264) in
                             let R1_422_1=Load(MEM_403, Plus(SP_EL0_5_1, s16)) in
                             let mac_424_1=mac(Enc_405_1, km_1) in
                             out(att,mac_424_1)
                             else out(att,s524);
                                  let R0_428_1=s0 in
                                  0
                                  else out(att,s540);
                                       let R0_431_1=s0 in
                                       0
                                       else out(att,s548))))).


// Check unlinkability in the presence of architectural leakage

let system1 =
  (new k_e; new k_m; (passport(k_e,k_m) | reader(k_e,k_m))) |
  (new k_e; new k_m; (passport(k_e,k_m) | reader(k_e,k_m))).

let system2 =
  new k_e; new k_m;
  (
    passport(k_e,k_m) | reader(k_e,k_m) |
    passport(k_e,k_m) | reader(k_e,k_m)
  ).


query trace_equiv(system1,system2).
